# ============================================================
# Vehicle Intelligence Platform — variables d'environnement
# Copier ce fichier en ".env" et adapter les valeurs si besoin.
# Aucune de ces valeurs par défaut n'est un vrai secret de production.
# ============================================================

# ---------- Base de données PostgreSQL ----------
POSTGRES_USER=vehicle_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=vehicle_platform
# Utilisé par le backend Spring Boot (host "postgres" quand lancé via docker-compose,
# "localhost" en exécution locale directe — voir docs/installation.md)
DATABASE_URL=jdbc:postgresql://localhost:5432/vehicle_platform

# ---------- Sécurité / JWT ----------
# Générer une vraie valeur aléatoire longue avant toute démonstration :
#   openssl rand -base64 48
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Mode démonstration ----------
# true  -> le backend peut compléter les données manquantes avec un jeu de
#          données local clairement marqué "Demo data" quand une API externe
#          n'est pas configurée ou est indisponible.
# false -> aucune donnée de démonstration n'est jamais renvoyée.
DEMO_MODE=true

# ---------- APIs externes ----------
# NHTSA vPIC est public et ne nécessite AUCUNE clé.
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Ces APIs nécessitent un compte/clé payante ou n'ont pas d'offre publique
# exploitable sans contrat commercial (voir docs/api-comparison.md).
# Laisser vide si vous n'avez pas de clé : le provider correspondant restera
# désactivé et l'application utilisera le mode démonstration à la place.
CARQUERY_API_URL=
MARKETCHECK_API_KEY=
AUTODEV_API_KEY=
EDMUNDS_API_KEY=

# Ces deux-là SONT intégrées et utiles dès qu'une clé est renseignée :
# - API_NINJAS_KEY : recherche de secours (/v1/cars) pour les véhicules hors catalogue démo.
# - CARSXE_API_KEY : vraies photos de véhicules (/images), persistées après le premier appel.
API_NINJAS_KEY=
CARSXE_API_KEY=

# ---------- Cache ----------
CACHE_TTL_HOURS=24

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api
